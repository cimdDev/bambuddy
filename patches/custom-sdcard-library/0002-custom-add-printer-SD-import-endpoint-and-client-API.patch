+@router.post("/{printer_id}/files/import-to-library", response_model=ImportPrinterFilesResponse)
+async def import_printer_files_to_library(
+    printer_id: int,
+    request: ImportPrinterFilesRequest,
+    _=RequirePermissionIfAuthEnabled(Permission.PRINTERS_FILES),
+    current_user: User | None = Depends(require_permission_if_auth_enabled(Permission.LIBRARY_UPLOAD)),
+    db: AsyncSession = Depends(get_db),
+):
+    """Copy files from printer SD storage into Bambuddy library storage."""
+    result = await db.execute(select(Printer).where(Printer.id == printer_id))
+    printer = result.scalar_one_or_none()
+    if not printer:
+        raise HTTPException(404, "Printer not found")
+
+    if request.folder_id is not None:
+        folder_result = await db.execute(select(LibraryFolder).where(LibraryFolder.id == request.folder_id))
+        if folder_result.scalar_one_or_none() is None:
+            raise HTTPException(404, "Target folder not found")
+
+    imported: list[ImportPrinterFileResult] = []
+    errors: list[ImportPrinterFileError] = []
+    files_dir = get_library_files_dir()
+    thumbnails_dir = get_library_thumbnails_dir()
+
+    for remote_path in request.paths:
+        remote_path = remote_path.strip()
+        if not remote_path:
+            errors.append(ImportPrinterFileError(path=remote_path, error="Path cannot be empty"))
+            continue
+
+        filename = Path(remote_path).name
+        if not filename:
+            errors.append(ImportPrinterFileError(path=remote_path, error="Invalid file path"))
+            continue
+
+        stored_path: Path | None = None
+        try:
+            data = await download_file_bytes_async(
+                printer.ip_address,
+                printer.access_code,
+                remote_path,
+                printer_model=printer.model,
+            )
+            if data is None:
+                errors.append(ImportPrinterFileError(path=remote_path, error="File not found on printer"))
+                continue
+
+            ext = Path(filename).suffix.lower()
+            file_type = ext[1:] if ext else "unknown"
+
+            unique_filename = f"{uuid4().hex}{ext}"
+            stored_path = files_dir / unique_filename
+            stored_path.write_bytes(data)
+
+            file_hash = calculate_file_hash(stored_path)
+            dup_result = await db.execute(select(LibraryFile.id).where(LibraryFile.file_hash == file_hash).limit(1))
+            duplicate_of = dup_result.scalar()
+
+            metadata: dict | None = None
+            thumbnail_path: str | None = None
+
+            if ext == ".3mf":
+                try:
+                    parser = ThreeMFParser(str(stored_path))
+                    raw_metadata = parser.parse()
+                    thumbnail_data = raw_metadata.get("_thumbnail_data")
+                    thumbnail_ext = raw_metadata.get("_thumbnail_ext", ".png")
+                    if thumbnail_data:
+                        thumb_filename = f"{uuid4().hex}{thumbnail_ext}"
+                        thumb_path = thumbnails_dir / thumb_filename
+                        with open(thumb_path, "wb") as thumb_file:
+                            thumb_file.write(thumbnail_data)
+                        thumbnail_path = str(thumb_path)
+                    metadata = _clean_metadata_for_storage(raw_metadata)
+                except Exception as e:
+                    logger.warning("Failed to parse imported 3MF from printer path %s: %s", remote_path, e)
+            elif ext == ".gcode":
+                try:
+                    thumb_data = extract_gcode_thumbnail(stored_path)
+                    if thumb_data:
+                        thumb_filename = f"{uuid4().hex}.png"
+                        thumb_path = thumbnails_dir / thumb_filename
+                        with open(thumb_path, "wb") as thumb_file:
+                            thumb_file.write(thumb_data)
+                        thumbnail_path = str(thumb_path)
+                except Exception as e:
+                    logger.warning("Failed to extract imported gcode thumbnail from %s: %s", remote_path, e)
+            elif ext.lower() in IMAGE_EXTENSIONS:
+                thumbnail_path = create_image_thumbnail(stored_path, thumbnails_dir)
+            elif ext == ".stl":
+                thumbnail_path = generate_stl_thumbnail(stored_path, thumbnails_dir)
+
+            library_file = LibraryFile(
+                folder_id=request.folder_id,
+                filename=filename,
+                file_path=to_relative_path(stored_path),
+                file_type=file_type,
+                file_size=len(data),
+                file_hash=file_hash,
+                thumbnail_path=to_relative_path(thumbnail_path) if thumbnail_path else None,
+                file_metadata=metadata,
+                created_by_id=current_user.id if current_user else None,
+            )
+            db.add(library_file)
+            await db.flush()
+
+            imported.append(
+                ImportPrinterFileResult(
+                    path=remote_path,
+                    file_id=library_file.id,
+                    filename=library_file.filename,
+                    duplicate_of=duplicate_of,
+                )
+            )
+
+            if request.delete_after_import:
+                deleted = await delete_file_async(
+                    printer.ip_address,
+                    printer.access_code,
+                    remote_path,
+                    printer_model=printer.model,
+                )
+                if not deleted:
+                    errors.append(
+                        ImportPrinterFileError(
+                            path=remote_path,
+                            error="Imported but failed to remove source file from printer",
+                        )
+                    )
+
+        except Exception as e:
+            logger.exception("Failed importing printer file %s to library", remote_path)
+            errors.append(ImportPrinterFileError(path=remote_path, error=str(e)))
+            if stored_path and stored_path.exists():
+                try:
+                    stored_path.unlink()
+                except OSError:
+                    pass
+
+    return ImportPrinterFilesResponse(imported=imported, errors=errors)
+
