+class ImportPrinterFilesRequest(BaseModel):
+    paths: list[str] = Field(..., min_length=1)
+    folder_id: int | None = None
+    delete_after_import: bool = False
+
+
+class ImportPrinterFileResult(BaseModel):
+    path: str
+    file_id: int
+    filename: str
+    duplicate_of: int | None = None
+
+
+class ImportPrinterFileError(BaseModel):
+    path: str
+    error: str
+
+
+class ImportPrinterFilesResponse(BaseModel):
+    imported: list[ImportPrinterFileResult]
+    errors: list[ImportPrinterFileError]
+
+
+def _clean_metadata_for_storage(obj):
+    """Strip non-JSON fields from parsed metadata before DB storage."""
+    if isinstance(obj, dict):
+        return {
+            k: _clean_metadata_for_storage(v)
+            for k, v in obj.items()
+            if not isinstance(v, bytes) and k not in ("_thumbnail_data", "_thumbnail_ext")
+        }
+    if isinstance(obj, list):
+        return [_clean_metadata_for_storage(i) for i in obj if not isinstance(i, bytes)]
+    if isinstance(obj, bytes):
+        return None
+    return obj
+
